<style>
  .stub-shell {
    padding-inline: var(--quarter);
  }
  @media (min-width: 1024px) {
    .stub-shell {
      padding-inline: var(--half);
    }
  }
  :global(.stub-piece) {
    max-width: 800px;
    margin-inline: auto;
  }
</style>
