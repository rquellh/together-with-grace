---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import GiveForm from '../components/GiveForm.astro';
import sewingTogether from '../assets/photos/sewing-together.jpeg';

const costs = [
  { price: '$100', what: 'A month of lunches for the 25–30 women at the center' },
  { price: '$100', what: 'Sewing machine and iron maintenance and repair' },
  { price: '$500', what: 'A month’s rent: two sewing rooms, a kitchen, an office' },
  { price: '$175', what: 'A month of electricity, water, and internet' },
];

const tilts = [-2, 1.5, -1, 2];
---

<Base
  title="Give — Together with Grace"
  description="Give toward the recurring costs of the sewing center in Libreville, Gabon."
>
  <section class="cloth-orange title-band">
    <div class="band">
      <div class="wrap">
        <h1>Give</h1>
      </div>
    </div>
    <div class="cut-edge ink" aria-hidden="true"></div>
  </section>

  <!-- THE COSTS: tags on a thread, strung across plain ink cloth (the print clashed with the tags) -->
  <section class="costs on-ink">
    <div class="wrap">
      <div class="costs-head">
        <h2>What a dollar becomes</h2>
        <p class="costs-lead">
          Apart from card fees, every dollar goes to the work. Unless you specify otherwise, your
          donation covers one or more of these recurring costs.
        </p>
      </div>
      <div class="tags">
        {
          costs.map((c, i) => (
            <div class="tag" style={`--tilt:${tilts[i]}deg`}>
              <span class="thread" aria-hidden="true"></span>
              <span class="price">{c.price}</span>
              <p>{c.what}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="cut-edge ink flip" aria-hidden="true"></div>

  <section class="page-section give-cta">
    <div class="wrap">
      <div class="give-grid">
        <figure class="give-photo" style="--tilt:-1.4deg">
          <Image
            src={sewingTogether}
            alt="A woman at the sewing center smiles up from her machine, a tape measure around her neck, while others sew behind her"
            width={1040}
            height={780}
            fit="cover"
          />
        </figure>
        <GiveForm />
      </div>
      <div class="check">
        <p class="caps check-label">Prefer to mail a check?</p>
        <p class="check-line">Make it payable to Together with Grace and send it to:</p>
        <address class="mail-label">
          <span class="caps mail-name">Together with Grace</span>
          <span>15085 Timberwood Ln.</span>
          <span>Minster, OH 45865</span>
        </address>
      </div>
    </div>
  </section>
</Base>

<style>
  .title-band {
    position: relative;
    /* room for the ink cut edge pinned along the bottom of the orange cloth */
    padding-block: clamp(2rem, 5vw, 3rem) calc(clamp(2rem, 5vw, 3rem) + 14px);
  }

  .title-band .cut-edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }

  .band {
    background: var(--muslin);
    box-shadow: var(--shadow-soft);
  }

  .band .wrap {
    padding-block: 2rem;
    text-align: center;
  }

  .title-band h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }

  /* ---------- costs (ink band) ---------- */

  .costs {
    padding-block: clamp(3.5rem, 8vh, 5.5rem);
  }

  .costs-head {
    max-width: 100%;
    margin-bottom: 3.4rem;
  }

  .costs h2 {
    color: var(--muslin);
    margin-bottom: 1rem;
  }

  .costs-lead {
    max-width: 58ch;
    font-size: 1.05rem;
    color: rgb(246 232 208 / 0.92);
  }

  .tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    align-items: flex-start;
    padding-top: 1rem;
  }

  .tags::before {
    /* the thread the tags hang from */
    content: '';
    position: absolute;
    top: 0.35rem;
    left: -4%;
    right: -4%;
    border-top: 2px dashed rgb(246 232 208 / 0.5);
    transform: rotate(-0.6deg);
  }

  .tag:nth-child(even) {
    margin-top: 1.6rem;
  }

  .tags .tag:nth-child(odd) {
    --drop: 1.05rem;
  }

  .tags .tag:nth-child(even) {
    --drop: 2.65rem;
  }

  .tags .thread {
    background: rgb(246 232 208 / 0.55);
  }

  /* ---------- giving: a print laid beside the form ---------- */

  .page-section {
    background: var(--muslin);
    padding-block: clamp(2.6rem, 6vw, 4rem);
  }

  .give-cta .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .give-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 26rem) minmax(0, 35rem);
    justify-content: center;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .give-grid > * {
    min-width: 0;
  }

  .give-grid :global(.give-embed) {
    /* fill the column; otherwise the widget sizes itself to its 560px maximum
       and overflows a phone screen */
    width: 100%;
  }

  .give-photo {
    /* matted snapshot, as on the home story */
    margin: 0;
    background: var(--selvage-white);
    padding: 0.45rem 0.45rem 0.55rem;
    box-shadow: var(--shadow-soft);
    transform: rotate(var(--tilt, 0deg));
  }

  .give-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- by mail: a stitched mailing label ---------- */

  .check {
    margin-top: 2.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    text-align: center;
  }

  .check-label {
    color: var(--orange-text);
  }

  .check-line {
    max-width: var(--measure);
    font-size: 1.05rem;
  }

  .mail-label {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 0.5rem;
    padding: 1.1rem 2rem 1.2rem;
    background: var(--selvage-white);
    box-shadow: var(--shadow-soft);
    font-style: normal;
    font-size: 1.08rem;
    line-height: 1.5;
  }

  .mail-label::after {
    /* the inset stitch every label on the site carries */
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px dashed var(--orange-deep);
    opacity: 0.5;
    pointer-events: none;
  }

  .mail-name {
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  @media (max-width: 900px) {
    .give-grid {
      grid-template-columns: minmax(0, 35rem);
      justify-items: center;
    }

    .give-photo {
      /* on a phone the form comes first; the print follows it */
      order: 2;
      max-width: 22rem;
    }
  }

  @media (max-width: 720px) {
    .tags::before {
      display: none;
    }

    .tag:nth-child(even) {
      margin-top: 0;
    }

    .tag {
      max-width: 100%;
      flex: 1 1 100%;
    }
  }
</style>
