---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import GiveForm from '../components/GiveForm.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import sewingTogether from '../assets/photos/sewing-together.jpeg';
import finishedDolls from '../assets/photos/finished-dolls-pair.jpeg';
import cuttingTablePair from '../assets/photos/cutting-table-pair.jpeg';
import pinkHat from '../assets/photos/pink-hat-scissors.jpeg';
import roundMat from '../assets/photos/round-quilted-mat.jpeg';
import patternStudy from '../assets/photos/pattern-study.jpeg';
import animalsHeldHigh from '../assets/photos/animals-held-high.jpeg';
import waxPrintBag from '../assets/photos/wax-print-bag.jpeg';
import orangeBear from '../assets/photos/orange-bear.jpeg';
import berninaMachine from '../assets/photos/bernina-machine.jpeg';
import umbrellas from '../assets/photos/hands-of-grace-umbrellas.jpeg';
import quiltedPouch from '../assets/photos/quilted-pouch.jpeg';
import threadingNeedle from '../assets/photos/threading-the-needle.jpeg';
import handStitching from '../assets/photos/hand-stitching.jpeg';
import twoDolls from '../assets/photos/two-dolls.jpeg';
import greenDress from '../assets/photos/green-dress-machine.jpeg';

const costs = [
  { price: '$100', what: 'A month of lunches for the 25–30 women at the center' },
  { price: '$100', what: 'Sewing machine and iron maintenance and repair' },
  { price: '$500', what: 'A month’s rent: two sewing rooms, a kitchen, an office' },
  { price: '$175', what: 'A month of electricity, water, and internet' },
];

const tilts = [-2, 1.5, -1, 2];

// the prints pinned along the cloth below the costs, in the order they drift past.
// None of these hang on the home hero, and the two laid beside the form are left
// out so nothing repeats on the page.
const stripPhotos = [
  { src: cuttingTablePair, alt: 'Two women in headwraps smile across a cutting table laid with a ruler and brown fabric' },
  { src: orangeBear, alt: 'A woman in a blue striped dress holds up an orange polka-dot stuffed bear she has sewn' },
  { src: patternStudy, alt: 'Two women work through figures on paper with a calculator during business training' },
  { src: roundMat, alt: 'A woman laughs as she holds up a round coiled mat she has made' },
  { src: waxPrintBag, alt: 'A woman in a coral headwrap holds out a blue and orange wax-print bag she has sewn' },
  { src: animalsHeldHigh, alt: 'A row of women at the center hold up the stuffed bears, elephants, and rabbits they have sewn' },
  { src: berninaMachine, alt: 'A woman in a red headwrap smiles over her sewing machine as she feeds yellow fabric through' },
  { src: pinkHat, alt: 'A woman in a pink sun hat and a blue wax-print dress grins with her scissors, a tape measure around her neck' },
  { src: umbrellas, alt: 'Four women hold open blue umbrellas printed with the Hands of Grace logo' },
  { src: quiltedPouch, alt: 'A woman laughs as she holds up a small green quilted pouch, a tape measure around her neck' },
  { src: greenDress, alt: 'A woman in a green dress with a tape measure around her neck smiles beside her sewing machine' },
  { src: twoDolls, alt: 'A woman holds up two cloth dolls with dark yarn hair in matching wax-print dresses' },
  { src: handStitching, alt: 'A woman in a red headwrap hand-stitches a small fabric ornament at a wooden table' },
  { src: threadingNeedle, alt: 'A woman in a yellow and pink headwrap works thread through her machine, a spool of orange thread beside her' },
];
---

<Base
  title="Give — Together with Grace"
  description="Give toward the recurring costs of the sewing center in Libreville, Gabon."
>
  <section class="cloth-orange title-band">
    <div class="band">
      <div class="wrap">
        <h1>Give</h1>
      </div>
    </div>
  </section>

  <!-- THE COSTS: tags on a thread, strung across plain ink cloth (the print clashed with the tags) -->
  <section class="costs on-ink hem-top hem-bottom">
    <div class="wrap">
      <div class="costs-head">
        <h2>What a dollar becomes</h2>
        <p class="costs-lead">
          Apart from card fees, every dollar goes to the work. Unless you specify otherwise, your
          donation covers one or more of these recurring costs.
        </p>
      </div>
      <div class="tags">
        {
          costs.map((c, i) => (
            <div class="tag" style={`--tilt:${tilts[i]}deg`}>
              <span class="thread" aria-hidden="true"></span>
              <span class="price">{c.price}</span>
              <p>{c.what}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- prints pinned along the orange cloth, drifting past as on the home hero -->
  <section class="cloth-orange print-strip">
    <PhotoStrip photos={stripPhotos} />
  </section>

  <section class="page-section give-cta">
    <div class="wrap">
      <div class="give-grid">
        <div class="give-prints">
          <figure class="give-photo" style="--tilt:-1.4deg">
            <Image
              src={sewingTogether}
              alt="A woman at the sewing center smiles up from her machine, a tape measure around her neck, while others sew behind her"
              width={1040}
              height={780}
              fit="cover"
            />
          </figure>
          <figure class="give-photo" style="--tilt:1.6deg">
            <Image
              src={finishedDolls}
              alt="A woman at the center beams as she holds up a pair of cloth dolls she has sewn"
              width={1040}
              height={780}
              fit="cover"
            />
          </figure>
        </div>
        <GiveForm />
      </div>
      <div class="check">
        <address class="mail-label">
          <span class="caps mail-name">Prefer to mail a check?</span>
          <span>Payable to Together with Grace</span>
          <span>15085 Timberwood Ln.</span>
          <span>Minster, OH 45865</span>
        </address>
      </div>
    </div>
  </section>
</Base>

<style>
  .title-band {
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  .band {
    background: var(--muslin);
    box-shadow: var(--shadow-soft);
  }

  .band .wrap {
    padding-block: 2rem;
    text-align: center;
  }

  .title-band h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }

  /* ---------- costs (ink band) ---------- */

  .costs {
    padding-block: clamp(3.5rem, 8vh, 5.5rem);
  }

  .costs-head {
    max-width: 100%;
    margin-bottom: 3.4rem;
  }

  .costs h2 {
    color: var(--muslin);
    margin-bottom: 1rem;
  }

  .costs-lead {
    max-width: 58ch;
    font-size: 1.05rem;
    color: rgb(246 232 208 / 0.92);
  }

  .tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    align-items: flex-start;
    padding-top: 1rem;
  }

  .tags::before {
    /* the thread the tags hang from */
    content: '';
    position: absolute;
    top: 0.35rem;
    left: -4%;
    right: -4%;
    border-top: 2px dashed rgb(246 232 208 / 0.5);
    transform: rotate(-0.6deg);
  }

  .tag:nth-child(even) {
    margin-top: 1.6rem;
  }

  .tags .tag:nth-child(odd) {
    --drop: 1.05rem;
  }

  .tags .tag:nth-child(even) {
    --drop: 2.65rem;
  }

  .tags .thread {
    background: rgb(246 232 208 / 0.55);
  }

  /* ---------- the strip of prints ---------- */

  .print-strip {
    padding-block: clamp(1.2rem, 3vw, 2.2rem);
  }

  /* ---------- giving: a print laid beside the form ---------- */

  .page-section {
    background: var(--muslin);
    padding-block: clamp(2.6rem, 6vw, 4rem);
  }

  .give-cta .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .give-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 33rem) minmax(0, 35rem);
    justify-content: center;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .give-grid > * {
    min-width: 0;
  }

  .give-grid :global(.give-embed) {
    /* fill the column; otherwise the widget sizes itself to its 560px maximum
       and overflows a phone screen */
    width: 100%;
  }

  .give-prints {
    /* two prints laid down beside the form, one a little to the right of the other */
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .give-prints .give-photo {
    width: min(100%, 29rem);
  }

  .give-prints .give-photo:first-child {
    align-self: flex-start;
  }

  .give-prints .give-photo:last-child {
    align-self: flex-end;
  }

  .give-photo {
    /* matted snapshot, as on the home story */
    margin: 0;
    background: var(--selvage-white);
    padding: 0.45rem 0.45rem 0.55rem;
    box-shadow: var(--shadow-soft);
    transform: rotate(var(--tilt, 0deg));
  }

  .give-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- by mail: a stitched mailing label ---------- */

  .check {
    margin-top: 2.6rem;
    display: flex;
    justify-content: center;
  }

  .mail-label {
    /* the same stitched label that closes the About page */
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 1.1rem 2rem 1.2rem;
    background: var(--selvage-white);
    box-shadow: var(--shadow-soft);
    font-style: normal;
    font-size: 1.05rem;
    line-height: 1.5;
    text-align: center;
  }

  .mail-label::after {
    /* the inset stitch every label on the site carries */
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px dashed var(--orange-deep);
    opacity: 0.5;
    pointer-events: none;
  }

  .mail-name {
    color: var(--orange-text);
    margin-bottom: 0.3rem;
  }

  @media (max-width: 900px) {
    .give-grid {
      grid-template-columns: minmax(0, 35rem);
      justify-items: center;
    }

    .give-prints {
      /* on a phone the form comes first; the prints follow it */
      order: 2;
      width: 100%;
      max-width: 26rem;
    }
  }

  @media (max-width: 720px) {
    .tags::before {
      display: none;
    }

    .tag:nth-child(even) {
      margin-top: 0;
    }

    .tag {
      max-width: 100%;
      flex: 1 1 100%;
    }
  }
</style>
