---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Piece from '../components/Piece.astro';
import PointerArrow from '../components/PointerArrow.astro';
import StampButton from '../components/StampButton.astro';
import YardageChart from '../components/YardageChart.astro';
import Steps from '../components/Steps.astro';
import portraitImage from '../assets/images/stand-in-portrait.jpg';
import approachImage from '../assets/images/stand-in-approach.jpg';

const team = [
  { name: 'Nadege', role: 'Production Overseer' },
  { name: 'Rolande', role: 'Production Recorder & Transfer Courier' },
  { name: 'Delicate', role: 'Inventory Control' },
  { name: 'Celine', role: 'Reporting Clerk' },
  { name: 'Marie Gabrielle', role: 'Translator' },
  { name: 'Yvonne', role: 'Housekeeping' },
];
---

<Base
  title="Together with Grace — Sharing God's Love with African Women"
  description="Together with Grace is a 501(c)(3) that trains and supports women at the Hands of Grace sewing center in Libreville, Gabon. Sponsor a student for $30 a month."
  mainClass="home"
>
  <section class="section hero">
    <div class="container hero__grid">
      <Piece as="div" shape="bodice" label="PIECE 1 · FRONT" cut="CUT 1" org class="hero__piece" style="--i: 0">
        <h1>Sharing God's Love with African Women</h1>
        <p class="lead hero__lead">
          A sewing center in Libreville, Gabon, where women learn a trade, a business, and the Bible — taught by
          people who have been going there since 2013.
        </p>

        <div class="monumental">
          <p class="monumental__row">
            <span class="monumental__amount tabular">$30</span>
            <span class="monumental__unit">a month</span>
          </p>
          <p class="monumental__desc">
            keeps one woman at her machine — her training, her daily meal, and her place at the center.
          </p>
        </div>

        <div class="hero__actions">
          <div class="hero__primary-action">
            <PointerArrow />
            <StampButton href="/give" label="Sponsor a student" />
          </div>
          <StampButton href="#how-it-works" label="How the center works" variant="outline" />
        </div>
      </Piece>

      <figure class="hero__figure photo-plate" style="--i: 1">
        <span class="photo-plate__pin photo-plate__pin--left" aria-hidden="true">
          <svg viewBox="0 0 24 40" focusable="false">
            <line x1="12" y1="12" x2="12" y2="36" stroke="var(--ink)" stroke-width="2" />
            <circle cx="12" cy="8" r="6" fill="var(--orange)" stroke="var(--ink)" stroke-width="1" />
          </svg>
        </span>
        <Image
          src={portraitImage}
          alt="A student at the Hands of Grace sewing center in Libreville, Gabon"
          width={720}
          height={832}
          loading="eager"
          fetchpriority="high"
          class="photo-plate__img"
        />
        <span class="photo-plate__pin photo-plate__pin--right" aria-hidden="true">
          <svg viewBox="0 0 24 40" focusable="false">
            <line x1="12" y1="12" x2="12" y2="36" stroke="var(--ink)" stroke-width="2" />
            <circle cx="12" cy="8" r="6" fill="var(--orange)" stroke="var(--ink)" stroke-width="1" />
          </svg>
        </span>
        <figcaption class="photo-plate__caption label">HANDS OF GRACE CENTER · LIBREVILLE, GABON</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What your gift makes</h2>
      <p class="section-intro">
        The center's recurring costs, as the ministry publishes them. Sponsorship is monthly; the other lines show
        what a one-time gift covers for a month.
      </p>
      <YardageChart style="--i: 2" />
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="container">
      <Steps style="--i: 3" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Who keeps the center running</h2>
      <p class="section-intro">
        The center is run by the women who work there. Together with Grace is their Ohio board.
      </p>
      <Piece as="div" shape="rect" label="PIECE 4 · ROLL" cut="CENTER STAFF" class="roll-piece" style="--i: 4">
        <dl class="roll-list">
          {
            team.map((member) => (
              <div class="roll-list__row">
                <dt class="roll-list__name">{member.name}</dt>
                <dd class="roll-list__role label">{member.role}</dd>
              </div>
            ))
          }
        </dl>
      </Piece>
      <p class="section-note">
        Together with Grace board: Vicki Quellhorst, President · Tim Quellhorst, Co-founder · Sandy Meyer, Vice
        President · Sarah Lewan, Secretary · Chris Fyock, Treasurer · Deb Kramer · Ryan Quellhorst, Tech Advisor.
      </p>
      <StampButton href="/who-we-are" label="Meet the team" variant="outline" surface="mat" />
    </div>
  </section>

  <section class="section">
    <div class="container update-grid">
      <Piece as="div" shape="sleeve" label="PIECE 3 · UPDATE" cut="APRIL 2026" class="update-piece" style="--i: 5">
        <h2>From the latest trip</h2>
        <p class="label update-piece__date">APRIL 27 – MAY 18, 2026 · LIBREVILLE</p>
        <p>
          The spring 2026 trip opened a second location in Port-Gentil and brought an invitation to speak at the
          National Synod in July. Student sponsorship continues at $30 a month.
        </p>
        <StampButton href="/news/april-2026" label="Read the April update" variant="outline" />
      </Piece>

      <figure class="update-figure photo-plate" style="--i: 6">
        <Image
          src={approachImage}
          alt="Students at work in the sewing room"
          width={640}
          height={480}
          loading="lazy"
          class="photo-plate__img"
        />
        <figcaption class="photo-plate__caption label">THE SEWING ROOM</figcaption>
      </figure>
    </div>
  </section>

  <section class="section founders-note">
    <div class="container">
      <p class="founders-note__body">
        Together with Grace was formed in November 2023 so the center's friends in Ohio could support it as a
        501(c)(3). Before that, for thirteen years, it was Vicki and Tim driving to the airport.
      </p>
      <p class="founders-note__verse">
        “Each of you should use whatever gift you have received to serve others, as faithful stewards of God's
        grace in its various forms.”
      </p>
      <p class="label founders-note__ref">1 PETER 4:10</p>
      <StampButton href="/give" label="Sponsor a student" />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: var(--half);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--quarter);
    align-items: start;
  }

  /* Piece 1 first, plate after, in DOM order — this is also the visual
     order at every width now (see item 6), so no `order` property is
     needed at all. */
  :global(.hero__piece) {
    grid-column: 1 / 13;
  }

  /* `.hero__figure.photo-plate` (both classes — they're on the same
     element), not just `.hero__figure`: the shared `.photo-plate {
     margin: 0 }` reset below has equal (0,1,0) specificity and comes
     later in this file, so a bare `.hero__figure` margin rule here would
     silently lose to it. */
  .hero__figure.photo-plate {
    grid-column: 1 / 13;
    margin-top: var(--half);
  }

  @media (min-width: 1024px) {
    :global(.hero__piece) {
      grid-column: 1 / 9;
      grid-row: 1;
      align-self: start;
    }
    .hero__figure.photo-plate {
      /* Adjacent to, then pulled left by exactly one inch, so the plate's
         left edge rides over the piece's right edge by a fixed 96px at
         any viewport width — more predictable than relying on however
         wide a shared grid track happens to render. */
      grid-column: 9 / 13;
      grid-row: 1;
      align-self: start;
      /* The grid's own column gap (var(--quarter)) already separates
         these two adjacent tracks, so pulling left by exactly var(--unit)
         would only yield a var(--unit) - var(--quarter) overlap. Add the
         gap back in so the overlap is a true, exact one inch. */
      margin-left: calc(-1 * (var(--unit) + var(--quarter)));
      margin-top: var(--half);
      z-index: 2;
    }
  }

  /* At >=1024px the photo plate overlaps the piece's rightmost 96px (see
     item 1 above). The piece label's normal top-right position (inset
     var(--half) = 48px from the edge) sits inside that covered strip, so
     push it further left, clear of the plate, on the hero piece only. */
  @media (min-width: 1024px) {
    :global(.hero__piece .piece__label) {
      right: calc(var(--unit) + var(--quarter));
    }
  }

  .hero__lead {
    max-width: 38ch;
  }

  /* Tagline rank: the $30 mark below carries the first viewport now. */
  :global(.hero__piece h1) {
    font-size: 2rem;
    line-height: 1;
  }
  @media (min-width: 640px) {
    :global(.hero__piece h1) {
      font-size: 2.75rem;
    }
  }

  .monumental {
    margin-block: var(--quarter);
  }

  .monumental__row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 0;
  }

  .monumental__amount {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 5rem;
    letter-spacing: -0.02em;
    color: var(--orange);
    line-height: 1;
  }

  @media (min-width: 640px) {
    .monumental__amount {
      font-size: 8rem;
    }
  }

  .monumental__unit {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (min-width: 640px) {
    .monumental__unit {
      font-size: 2rem;
    }
  }

  .monumental__desc {
    margin-top: var(--quarter);
    max-width: 42ch;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--half);
  }

  .hero__primary-action {
    display: flex;
    align-items: center;
    gap: var(--quarter);
    flex-wrap: wrap;
  }

  /* Compact the mobile stack so the primary stamp clears the first
     viewport. Each margin-top pairs with the preceding element's
     margin-bottom set to 0, so the gap is exactly the stated value
     rather than whatever the two collapse to. */
  @media (max-width: 639px) {
    .hero {
      padding-top: var(--quarter);
    }

    :global(.hero__piece h1) {
      line-height: 0.95;
      margin-top: 12px;
      margin-bottom: 0;
    }

    .hero__lead {
      font-size: 1.0625rem;
      max-width: 30ch;
      margin-top: 12px;
      margin-bottom: 0;
    }

    .monumental {
      margin-top: 12px;
      margin-bottom: 0;
    }

    .monumental__amount {
      font-size: 4.5rem;
    }

    .monumental__unit {
      font-size: 1.25rem;
    }

    .monumental__desc {
      font-size: 1rem;
      margin-top: 8px;
      margin-bottom: 0;
    }

    .hero__actions {
      margin-top: 12px;
    }
  }

  .photo-plate {
    position: relative;
    margin: 0;
    border: 1.5px solid var(--ink);
    background: var(--tissue);
  }

  .photo-plate__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Below the hero's own 1024px breakpoint, the portrait would otherwise
     render at its full intrinsic ratio (2250x2603, ~670px tall at a
     390px viewport), pushing the headline below the first screen. Crop
     it to a shorter plate instead; the intrinsic width/height attributes
     on the <Image> stay in place for CLS. */
  @media (max-width: 1023px) {
    .hero__figure .photo-plate__img {
      aspect-ratio: 4 / 3;
      object-fit: cover;
      object-position: center 20%;
      width: 100%;
      height: auto;
    }
  }

  .photo-plate__caption {
    display: block;
    background: var(--tissue-translucent);
    color: var(--ink);
    padding: 12px var(--quarter);
    text-align: center;
  }

  .photo-plate__pin {
    position: absolute;
    top: -16px;
    z-index: 3;
    width: 24px;
    height: 40px;
  }
  .photo-plate__pin svg {
    width: 100%;
    height: 100%;
  }
  .photo-plate__pin--left {
    left: 20px;
    transform: rotate(-30deg);
    transform-origin: top center;
  }
  .photo-plate__pin--right {
    right: 20px;
    transform: rotate(30deg);
    transform-origin: top center;
  }

  .section-intro {
    color: var(--mat-ink-2);
    max-width: var(--measure);
  }

  .section-note {
    color: var(--mat-ink-2);
    max-width: none;
    margin-bottom: var(--half);
  }

  .roll-piece {
    margin-bottom: var(--half);
  }

  .roll-list {
    margin: 0;
  }

  .roll-list__row {
    padding-block: var(--quarter);
    border-top: 1px solid var(--ink);
  }
  .roll-list__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .roll-list__name {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1.5rem;
    margin: 0 0 2px;
  }

  .roll-list__role {
    margin: 0;
    color: var(--tissue-ink-2);
  }

  @media (min-width: 768px) {
    .roll-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
      column-gap: var(--unit);
    }
    /* First row of the second column: no rule above it either. */
    .roll-list__row:nth-child(4) {
      border-top: none;
      padding-top: 0;
    }
  }

  .update-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--half);
    align-items: start;
  }

  @media (min-width: 900px) {
    .update-grid {
      grid-template-columns: 3fr 2fr;
    }
  }

  .update-piece__date {
    color: var(--ink);
  }

  /* Left-aligned to the container's own left edge (same edge the pieces
     register to) — not centered as a block within the container. */
  .founders-note__body,
  .founders-note__verse {
    font-size: 1.25rem;
    max-width: 60ch;
  }

  .founders-note__verse {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--size-lead);
  }

  .founders-note__ref {
    color: var(--mat-ink-2);
  }
</style>
