---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import patternLesson from '../assets/photos/pattern-lesson.jpeg';
import openBible from '../assets/photos/open-bible.jpeg';
import sewingMachine from '../assets/photos/sewing-machine.jpeg';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}${path}`;

const costs = [
  { price: '$100', what: 'A month of lunches for the 25–30 women at the center' },
  { price: '$100', what: 'Sewing machine and iron maintenance and repair' },
  { price: '$500', what: 'A month’s rent: two sewing rooms, a kitchen, an office' },
  { price: '$175', what: 'A month of electricity, water, and internet' },
];

const selvageWords = ['Sewing', 'Business', 'Prayer', 'A daily meal', 'Libreville', 'Gabon', 'Véritable'];
---

<Base
  title="Together with Grace — Sharing God's Love with African Women"
  description="Together with Grace supports the Hands of Grace sewing center in Libreville, Gabon: sewing, business training, a daily meal, and daily prayer for Gabonese women."
>
  <!-- HERO: the bolt unrolled -->
  <section class="hero cloth-orange">
    <div class="bolt-band">
      <div class="wrap band-inner">
        <h1>Together with&nbsp;Grace</h1>
        <p class="tagline">Sharing God’s love with African women</p>
        <p class="origin caps">Minster, Ohio ⇄ Libreville, Gabon · since 2013</p>
        <div class="band-actions">
          <a class="btn" href="#story">Read our story</a>
          <a class="btn sun" href={withBase('/give/')}>Give</a>
        </div>
      </div>
    </div>
    <div class="selvage hero-selvage" aria-hidden="true">
      <p class="caps">
        {Array.from({ length: 3 }, () => selvageWords.map((w) => `${w}`).join(' ✦ ')).join(' ✦ ')}
      </p>
    </div>
  </section>

  <!-- THE WINDOW: pattern parts onto the real place -->
  <section class="window cloth-orange">
    <div class="wrap">
      <p class="window-lead"><span>Behind the pattern is a real place.</span></p>
      <div class="aperture">
        <div class="cut-edge muslin" aria-hidden="true"></div>
        <div class="aperture-reveal">
          <Image
            class="main-photo"
            src={patternLesson}
            alt="A pattern-cutting lesson at the center: women gathered around the table as a paper pattern is measured out on pink printed fabric"
            width={1680}
            height={1120}
            fit="cover"
          />
        </div>
        <div class="cut-edge muslin flip" aria-hidden="true"></div>
      </div>
      <p class="window-caption">
        <span>The Hands of Grace sewing center, Libreville: two sewing rooms, a kitchen, an office, and
        a midday meal shared by 25–30 women.</span>
      </p>
    </div>
  </section>

  <div class="cut-edge orange flip" aria-hidden="true"></div>

  <!-- THE STORY: measured in years on the muslin backing -->
  <section class="story" id="story">
    <div class="wrap">
      <h2>Thirteen years along one thread</h2>
      <div class="yarn">
        <article class="entry">
          <p class="year" aria-label="2013">2013</p>
          <div class="entry-text">
            <p>
              In June 2013, Vicki Quellhorst was called to ministry in Gabon. What began as one trip
              became a life’s work: teaching sewing and business, side by side with Gabonese women,
              with God’s word woven through every day of it.
            </p>
          </div>
        </article>
        <article class="entry">
          <p class="year" aria-label="A day at the center">Daily</p>
          <div class="entry-text">
            <p>
              A day at the center begins with praise singing and prayer. Then the machines start:
              sewing lessons, business and financial training, marketing, repair. At midday everyone
              shares a meal, and prayer requests are shared every day. The women carry one another.
            </p>
            <div class="snapshots">
              <figure class="snap" style="--tilt:-2deg">
                <Image
                  src={openBible}
                  alt="A woman at the center smiles beside an open Bible on a wax-print tablecloth"
                  width={840}
                  height={630}
                  fit="cover"
                />
                <figcaption class="caps">An open Bible on the table</figcaption>
              </figure>
              <figure class="snap" style="--tilt:1.6deg">
                <Image
                  src={sewingMachine}
                  alt="A trainee smiles at her machine while sewing an orange stuffed animal"
                  width={840}
                  height={630}
                  fit="cover"
                />
                <figcaption class="caps">At the machines</figcaption>
              </figure>
            </div>
          </div>
        </article>
        <article class="entry">
          <p class="year" aria-label="2023">2023</p>
          <div class="entry-text">
            <p>
              The center is run by Hands of Grace Ministry, our Gabonese partner. In November 2023 we
              formed Together with Grace, a 501(c)(3), so churches and sewing circles here in Ohio
              could stand behind the work there.
            </p>
          </div>
        </article>
        <article class="entry">
          <p class="year" aria-label="Today">Today</p>
          <div class="entry-text">
            <p>
              Vicki has now made fifteen trips to Gabon; her husband Tim has made four, keeping the
              machines running. Every lesson points at the same end we pray for: women launching
              businesses of their own, agents of change in their communities.
            </p>
          </div>
        </article>
      </div>
      <p class="story-close">
        The story continues: on the next trip, at the next machine, over the next shared
        meal. <a href={withBase('/about/')}>Meet everyone involved&nbsp;→</a>
      </p>
    </div>
  </section>

  <div class="cut-edge ink" aria-hidden="true"></div>

  <!-- THE COSTS: tags on a thread -->
  <section class="costs cloth-ink on-ink">
    <div class="wrap">
      <h2>What a dollar becomes</h2>
      <p class="costs-lead">
        Giving here is not abstract. Apart from card fees, every dollar goes to the work. Unless
        you specify otherwise, your gift covers these recurring costs:
      </p>
      <div class="tags">
        {
          costs.map((c, i) => (
            <div class="tag" style={`--tilt:${[-2, 1.5, -1, 2][i]}deg`}>
              <span class="thread" aria-hidden="true"></span>
              <span class="price">{c.price}</span>
              <p>{c.what}</p>
            </div>
          ))
        }
      </div>
      <div class="costs-actions">
        <a class="btn sun" href={withBase('/give/')}>Give</a>
        <p class="caps costs-note">Giving completes securely on togetherwithgrace.org</p>
      </div>
    </div>
  </section>

  <div class="cut-edge ink flip" aria-hidden="true"></div>

  <!-- NEWS: letters from the work -->
  <section class="news">
    <div class="wrap">
      <h2>News from the work</h2>
      <p class="news-line">
        Ryan Quellhorst, our tech advisor, writes news from the ministry a few times a year. The
        latest letter is <em>“April 2026.”</em>
      </p>
      <a class="btn" href={withBase('/news/')}>Read the news</a>
    </div>
  </section>

  <div class="cut-edge orange" aria-hidden="true"></div>

  <!-- CLOSE -->
  <section class="close-call">
    <div class="wrap">
      <h2>Be part of the making.</h2>
      <p class="close-line">
        Give toward a month of lunches or a month of rent. Or, if you sew, make jewelry, or know
        business, come with us on a short-term trip.
      </p>
      <div class="close-actions">
        <a class="btn" href={withBase('/give/')}>Give</a>
        <a class="btn ghost" href={withBase('/about/')}>Come sew with us</a>
      </div>
    </div>
  </section>
  <div class="cut-edge ink close-hem" aria-hidden="true"></div>
</Base>

<script>
  const reveal = document.querySelector('.aperture-reveal');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reveal && !reduced && 'IntersectionObserver' in window) {
    reveal.classList.add('primed');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            reveal.classList.add('open');
            io.disconnect();
          }
        }
      },
      { threshold: 0.45 },
    );
    io.observe(reveal);
  }
</script>

<style>
  /* ---------- hero ---------- */

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(88svh - 64px);
  }

  .bolt-band {
    background: var(--muslin);
    box-shadow: 0 14px 36px -14px rgb(0 27 39 / 0.55);
    margin-block: clamp(3rem, 12vh, 7rem);
    padding-block: clamp(2.2rem, 5vw, 3.8rem);
  }

  .band-inner {
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.7rem, 7.2vw, 5.9rem);
    letter-spacing: 0.005em;
  }

  .tagline {
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    margin-top: 1.1rem;
    color: var(--ink);
  }

  .origin {
    margin-top: 1.3rem;
    color: var(--orange-text);
  }

  .band-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.9rem;
  }

  .hero-selvage {
    margin-top: auto;
    overflow: hidden;
    padding-block: 0.55rem;
    border-top: 1px solid var(--muslin-deep);
  }

  .hero-selvage p {
    white-space: nowrap;
    color: var(--ink);
    opacity: 0.85;
  }

  /* ---------- window ---------- */

  .window {
    padding-block: 2.5rem clamp(4rem, 9vh, 7rem);
  }

  .window-lead,
  .window-caption {
    text-align: center;
    font-family: var(--font-serif);
  }

  .window-lead span,
  .window-caption span {
    display: inline-block;
    background: var(--muslin);
    padding: 0.55em 1.1em;
    box-shadow: var(--shadow-soft);
    font-size: 1.05rem;
    max-width: 52ch;
  }

  .window-lead {
    margin-bottom: 2.2rem;
  }

  .window-lead span {
    font-style: italic;
    font-size: 1.2rem;
  }

  .aperture {
    max-width: 56rem;
    margin-inline: auto;
  }

  .aperture .cut-edge {
    position: relative;
    z-index: 2;
  }

  .aperture-reveal {
    background: var(--ink-deep);
  }

  .aperture-reveal.primed .main-photo {
    clip-path: inset(46% 4% 46% 4%);
  }

  .aperture-reveal.primed.open .main-photo {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.2s cubic-bezier(0.16, 0.84, 0.28, 1) 0.15s;
  }

  .main-photo {
    display: block;
    width: 100%;
    height: auto;
  }

  .window-caption {
    margin-top: 2.2rem;
  }

  /* ---------- story ---------- */

  .story {
    background: var(--muslin);
    padding-block: clamp(4rem, 9vh, 6.5rem);
  }

  .story h2,
  .news h2,
  .costs h2,
  .close-call h2 {
    font-size: clamp(2rem, 4.5vw, 3.1rem);
  }

  .story h2 {
    margin-bottom: 3rem;
    max-width: 14ch;
  }

  .yarn {
    position: relative;
    display: grid;
    gap: 2.6rem;
    padding-left: clamp(4.2rem, 9vw, 6rem);
  }

  .yarn::before {
    /* the measuring tape */
    content: '';
    position: absolute;
    left: clamp(0.4rem, 2vw, 1.4rem);
    top: -0.6rem;
    bottom: -0.6rem;
    width: 20px;
    background:
      repeating-linear-gradient(to bottom, var(--orange-deep) 0 2px, transparent 2px 56px) left/20px 100% no-repeat,
      repeating-linear-gradient(to bottom, var(--orange-deep) 0 1.5px, transparent 1.5px 14px) left/11px 100% no-repeat;
    opacity: 0.75;
  }

  .entry {
    position: relative;
    max-width: var(--measure);
  }

  .year {
    position: absolute;
    left: calc(-1 * clamp(4.2rem, 9vw, 6rem));
    top: -0.15em;
    background: var(--muslin);
    padding-block: 0.2em;
    font-family: var(--font-sans);
    font-variation-settings: 'wdth' 78;
    font-weight: 750;
    font-size: 1.35rem;
    color: var(--orange-deep);
    letter-spacing: 0.02em;
  }

  .entry-text p {
    font-size: 1.08rem;
  }

  .snapshots {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin-top: 1.8rem;
  }

  .snap {
    flex: 1 1 14rem;
    max-width: 18rem;
    margin: 0;
    background: var(--selvage-white);
    padding: 0.45rem 0.45rem 0.6rem;
    transform: rotate(var(--tilt, 0deg));
    box-shadow: var(--shadow-soft);
  }

  .snap img {
    display: block;
    width: 100%;
    height: auto;
  }

  .snap figcaption {
    margin-top: 0.55rem;
    text-align: center;
  }

  .story-close {
    margin-top: 3.2rem;
    max-width: var(--measure);
    font-size: 1.08rem;
  }

  /* ---------- costs ---------- */

  .costs {
    padding-block: clamp(4rem, 9vh, 6.5rem);
  }

  .costs h2 {
    color: var(--muslin);
    margin-bottom: 1.4rem;
  }

  .costs-lead {
    max-width: 58ch;
    margin-bottom: 3.4rem;
    color: rgb(246 232 208 / 0.92);
  }

  .tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    align-items: flex-start;
    padding-top: 1rem;
  }

  .tags::before {
    /* the thread the tags hang from */
    content: '';
    position: absolute;
    top: 0.35rem;
    left: -4%;
    right: -4%;
    border-top: 2px dashed rgb(246 232 208 / 0.5);
    transform: rotate(-0.6deg);
  }

  .tag:nth-child(even) {
    margin-top: 1.6rem;
  }

  .tags .tag:nth-child(odd) {
    --drop: 1.05rem;
  }

  .tags .tag:nth-child(even) {
    --drop: 2.65rem;
  }

  .tags .thread {
    background: rgb(246 232 208 / 0.55);
  }

  .costs-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 3.2rem;
  }

  .costs-note {
    color: rgb(246 232 208 / 0.75);
  }

  /* ---------- news ---------- */

  .news {
    background: var(--muslin);
    padding-block: clamp(3.5rem, 7vh, 5rem);
    text-align: center;
  }

  .news h2 {
    margin-bottom: 1rem;
  }

  .news-line {
    max-width: 48ch;
    margin: 0 auto 1.8rem;
    font-size: 1.08rem;
  }

  /* ---------- close ---------- */

  .close-call {
    /* plain-woven orange: crackle without the printed motif, so the ink stamp reads */
    background-color: var(--orange);
    background-image: var(--crackle-orange-tile);
    background-size: 160px 160px;
    padding-block: clamp(4rem, 9vh, 6.5rem);
    text-align: center;
  }

  .close-call h2 {
    color: var(--ink-deep);
  }

  .close-line {
    max-width: 52ch;
    margin: 1.4rem auto 2rem;
    color: var(--ink-deep);
    font-size: 1.1rem;
  }

  .close-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .close-hem {
    background-color: var(--orange);
  }

  /* ---------- responsive ---------- */

  @media (max-width: 720px) {
    .yarn {
      /* the tape slims to a running stitch so the world's connective tissue survives */
      padding-left: 1.15rem;
      padding-top: 0.5rem;
      border-left: 2px dashed var(--orange-deep);
    }

    .yarn::before {
      display: none;
    }

    .year {
      position: static;
      display: inline-block;
      margin-bottom: 0.5rem;
      border-bottom: 2px solid var(--orange-deep);
      padding-block: 0;
    }

    .tags::before {
      display: none;
    }

    .tag:nth-child(even) {
      margin-top: 0;
    }

    .tag {
      max-width: 100%;
      flex: 1 1 100%;
    }
  }
</style>
