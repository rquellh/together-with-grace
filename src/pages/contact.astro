---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Base
  title="Contact — Together with Grace"
  description="Send us a note, or write to us in Minster, Ohio."
>
  <section class="cloth-orange title-band hem-bottom">
    <div class="band">
      <div class="wrap">
        <h1>Contact</h1>
      </div>
    </div>
  </section>

  <!-- SEND A NOTE: the form and the mailing address, side by side; ContactForm
       renders nothing on its own when no Web3Forms key is configured, so the
       address always stands on its own even then -->
  <section class="page-section note">
    <div class="wrap note-grid">
      <div class="note-text">
        <h2>Send us a note</h2>
        <p>
          Ask about a short-term trip, a month of lunches, or how your church or group might
          help. We read every note.
        </p>
        <p class="caps write-label">Or write to us</p>
        <address class="mail-label">
          <span>Together with Grace</span>
          <span>15085 Timberwood Ln.</span>
          <span>Minster, OH 45865</span>
        </address>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  /* ---------- title band (as on Give/About) ---------- */

  .title-band {
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  .band {
    background: var(--muslin);
    box-shadow: var(--shadow-soft);
  }

  .band .wrap {
    padding-block: 2rem;
    text-align: center;
  }

  .title-band h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }

  /* ---------- shared ---------- */

  .page-section {
    background: var(--muslin);
    padding-block: clamp(2.6rem, 6vw, 4rem);
  }

  .page-section h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    margin-bottom: 1.4rem;
  }

  .page-section p {
    max-width: var(--measure);
    font-size: 1.05rem;
  }

  /* ---------- send us a note ---------- */

  .note-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 56rem) {
    .note-grid {
      grid-template-columns: minmax(0, 24rem) minmax(0, 34rem);
      justify-content: space-between;
      align-items: start;
    }
  }

  .note-text p {
    margin-top: 0.9rem;
  }

  /* .note-text p (0,1,1) would otherwise beat a bare .write-label (0,1,0) */
  .note-text .write-label {
    color: var(--orange-text);
    margin-top: 2rem;
  }

  /* ---------- the stitched mailing label (as on Give/About) ---------- */

  .mail-label {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 1.1rem 2rem 1.2rem;
    background: var(--selvage-white);
    box-shadow: var(--shadow-soft);
    font-style: normal;
    font-size: 1.08rem;
    line-height: 1.5;
    text-align: center;
  }

  .mail-label::after {
    /* the inset stitch every label on the site carries */
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px dashed var(--orange-deep);
    opacity: 0.5;
    pointer-events: none;
  }
</style>
