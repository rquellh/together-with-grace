---
import '@fontsource/alfa-slab-one';
import '@fontsource-variable/archivo';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/bitter';
import '@fontsource-variable/bitter/wght-italic.css';
import '../styles/global.css';
import waxOrange from '../assets/wax-orange.svg';
import waxInk from '../assets/wax-ink.svg';
import crackleOrange from '../assets/crackle-orange.svg';
import crackleInk from '../assets/crackle-ink.svg';
import logoWide from '../assets/twg-logo-wide.svg';
import logoMark from '../assets/twg-logo-mark.svg';

interface Props {
  title: string;
  description: string;
  /** absolute URL of a link-preview image (letters pass their cover print) */
  image?: string;
  imageAlt?: string;
}

const { title, description, image, imageAlt } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}${path}`;
const current = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/give/', label: 'Give' },
  { href: '/news/', label: 'News' },
  { href: '/contact/', label: 'Contact' },
];

const tiles = [
  `--wax-orange-tile: url(${waxOrange.src})`,
  `--wax-ink-tile: url(${waxInk.src})`,
  `--crackle-orange-tile: url(${crackleOrange.src})`,
  `--crackle-ink-tile: url(${crackleInk.src})`,
].join('; ');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    {image && <meta property="og:image" content={image} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#e9670d" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  </head>
  <body style={tiles}>
    <!--
    THESIS: The site is cut from the cloth the women actually sew — one length of wax-print yardage; it refuses the nonprofit hero-photo-plus-icon-cards template.
    OWN-WORLD: Brand orange #E9670D and navy #002B3C as printed cloth fields with wax crackle; selvage strips carry wayfinding; muslin backing for reading; stitch focus rings, label buttons, strung tags, pinked cut edges; Alfa Slab One stamps, Archivo selvage caps, Bitter letters.
    STORY: A supporter meets the real work in Libreville, reads the 2013-to-today account, and follows the selvage to give.
    FIRST VIEWPORT: Full-bleed orange wax repeat under a selvage nav strip; a muslin bolt-band crosses it stamped with the logo and tagline; a strip of prints drifts along the cloth beneath it, and the selvage closes the hero.
    FORM: wax-print cloth; candidate 1 of 7 on the ordered list, user-locked pick over assigned #5; seed ec8d0899.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip" href="#main">Skip to content</a>
    <header class="selvage site-selvage">
      <div class="selvage-bar">
        <a class="selvage-brand" href={withBase('/')}>
          <img class="brand-logo" src={logoWide.src} alt="Together with Grace" width="1356" height="187" />
        </a>
        <button class="selvage-menu" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="selvage-menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="selvage-menu-label">Menu</span>
        </button>
        <nav id="site-nav" class="selvage-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
      <div class="selvage-dots" aria-hidden="true"></div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="on-ink care-label">
      <div class="wrap">
        <img class="care-mark" src={logoMark.src} alt="" width="549" height="603" />
        <p class="care-name">Together with Grace</p>
        <p class="care-line">
          A 501(c)(3) nonprofit · EIN 93-4192459 · 15085 Timberwood Ln., Minster, OH 45865
        </p>
        <p class="care-line">In support of Hands of Grace Ministry, Libreville, Gabon</p>
        <p class="care-line">
          Give securely on our <a href={withBase('/give/')}>Give page</a>, or{' '}
          <a href={withBase('/contact/')}>send us a note</a>.
        </p>
        <p class="care-verse">
          “Each of you should use whatever gift you have received to serve others, as faithful stewards
          of God’s grace in its various forms.” — 1 Peter 4:10
        </p>
        <p class="care-line care-copyright">© <span class="care-year">{new Date().getFullYear()}</span> Together with Grace</p>
      </div>
    </footer>
    <!-- the year is stamped at build time; this keeps it current between builds -->
    <script is:inline>
      document.querySelectorAll('.care-year').forEach((el) => {
        el.textContent = String(new Date().getFullYear());
      });
    </script>
    <script>
      // The site selvage does two things: (1) it hides on downward scroll once past
      // its own height and returns on any upward scroll or at the very top, publishing
      // its live height as --selvage-offset so the News rail can stick just under it;
      // (2) under 720px its links fold behind a hamburger button.
      function initHeader(): void {
        const header = document.querySelector<HTMLElement>('.site-selvage');
        if (!header) return;

        const nav = header.querySelector<HTMLElement>('#site-nav');
        const menuBtn = header.querySelector<HTMLButtonElement>('.selvage-menu');
        const isOpen = () => nav?.classList.contains('is-open') ?? false;

        const closeMenu = () => {
          if (!menuBtn || !nav) return;
          menuBtn.setAttribute('aria-expanded', 'false');
          nav.classList.remove('is-open');
        };

        const setOffset = () => {
          const hidden = header.classList.contains('is-hidden');
          document.documentElement.style.setProperty(
            '--selvage-offset',
            hidden ? '0px' : `${header.offsetHeight}px`
          );
        };

        const show = () => {
          header.classList.remove('is-hidden');
          setOffset();
        };

        const hide = () => {
          header.classList.add('is-hidden');
          closeMenu();
          setOffset();
        };

        let lastY = window.scrollY;
        let ignoreUntil = 0;
        let ticking = false;

        const update = () => {
          ticking = false;
          const y = window.scrollY;
          const now = performance.now();

          if (y <= 8) show();
          else if (now < ignoreUntil) {
            // an anchor jump just hid the header on purpose; let it be
          } else if (isOpen()) {
            // the menu is open: keep the header shown
          } else if (y > lastY + 4 && y > header.offsetHeight) hide();
          else if (y < lastY - 4) show();

          lastY = y;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
          },
          { passive: true }
        );

        window.addEventListener('resize', setOffset);

        // a page restored mid-scroll (back/forward cache) should start visible;
        // only an actual downward scroll from here on should hide it
        window.addEventListener(
          'load',
          () => {
            lastY = window.scrollY;
            show();
          },
          { once: true }
        );

        setOffset();

        // in-page anchor jumps: the News rail's own anchors assume it alone sits
        // at the top, so drop the header out of the way first
        document.addEventListener('click', (e) => {
          const target = e.target instanceof Element ? e.target : null;
          const link = target?.closest<HTMLAnchorElement>('a[href^="#"]');
          const hash = link?.getAttribute('href') ?? '';
          if (!link || hash === '' || hash === '#') return;
          hide();
          ignoreUntil = performance.now() + 600;
        });

        // hamburger: folds the nav behind a Menu button under 720px
        if (menuBtn && nav) {
          menuBtn.addEventListener('click', () => {
            const open = !isOpen();
            menuBtn.setAttribute('aria-expanded', String(open));
            nav.classList.toggle('is-open', open);
            setOffset();
          });

          nav.addEventListener('click', (e) => {
            const target = e.target instanceof Element ? e.target : null;
            if (target?.closest('a')) closeMenu();
          });

          document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape' || !isOpen()) return;
            closeMenu();
            menuBtn.focus();
          });

          window.matchMedia('(max-width: 720px)').addEventListener('change', (e) => {
            if (!e.matches) closeMenu();
          });
        }
      }

      initHeader();
    </script>
  </body>
</html>

<style>
  .care-label {
    padding: 3.5rem 0 2.5rem;
    text-align: center;
  }

  .care-label .wrap {
    max-width: 46rem;
    border: 1.5px dashed rgb(246 232 208 / 0.45);
    padding: 2.2rem clamp(1.2rem, 4vw, 2.8rem) 2rem;
  }

  .care-mark {
    height: 3.6rem;
    width: auto;
    margin-bottom: 0.9rem;
    /* the navy silhouette needs a light plate to read on the ink footer;
       square, like a woven label — the system is zero-radius */
    background: var(--selvage-white);
    padding: 0.5rem 0.65rem;
  }

  .care-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .care-line {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    margin-block: 0.35rem;
    color: rgb(246 232 208 / 0.88);
  }

  .care-verse {
    font-style: italic;
    font-size: 1.08rem;
    max-width: 44ch;
    margin: 1.4rem auto 1rem;
    color: var(--muslin);
  }

  .care-copyright {
    margin-top: 1.2rem;
    color: rgb(246 232 208 / 0.62);
  }
</style>
