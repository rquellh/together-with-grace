---
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';

export interface Props {
  title: string;
  description: string;
  ogImagePath?: string;
  mainClass?: string;
}

const { title, description, ogImagePath = 'images/og.jpg', mainClass } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase(ogImagePath), Astro.site);
const faviconHref = withBase('/favicon.svg');

// Mat-edge numerals: one per inch, drawn along the top edge on wide
// viewports only (see the mat-ruler rule below, revealed at >=1024px).
const rulerInches = Array.from({ length: 20 }, (_, i) => i + 1);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Mark JS as available before first paint, so the one authored
      // entrance motion on Home (gated on html.js) never flashes visible
      // content into a hidden state. Without this script (JS disabled),
      // .js is never added and content is simply, permanently visible.
      document.documentElement.classList.add('js');
    </script>

    <style is:global>
      .mat-ruler {
        display: none;
      }

      @media (min-width: 1024px) {
        .mat-ruler {
          display: flex;
          padding-left: var(--unit);
          height: 20px;
          overflow: hidden;
        }
        .mat-ruler__mark {
          flex: none;
          width: var(--unit);
          font-family: var(--font-label);
          font-size: 12px;
          color: var(--mat-ink-2);
          line-height: 20px;
        }
      }

      /* The one authored motion: pieces and photo plates settle onto the
         mat on Home only (see main.home). No-JS and reduced-motion users
         get the resting state immediately — never hidden by default. */
      html.js main.home .piece,
      html.js main.home .photo-plate {
        opacity: 0;
        transform: translateY(-12px) rotate(-1.2deg);
      }

      @media (prefers-reduced-motion: no-preference) {
        html.js[data-settled] main.home .piece,
        html.js[data-settled] main.home .photo-plate {
          opacity: 1;
          transform: translateY(0) rotate(0deg);
          transition:
            opacity 700ms var(--ease-out-expo),
            transform 700ms var(--ease-out-expo);
          transition-delay: min(calc(var(--i, 0) * 70ms), 200ms);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html.js main.home .piece,
        html.js main.home .photo-plate {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <!--
THESIS: The site is the pattern for a self-sufficient sewing center: the envelope back says what each gift makes, the instruction sheet shows how the center funds itself. It refuses the photo-hero, three-pillar, stat-counter page.
OWN-WORLD: Deep-teal cutting mat (#002B3C) with a real one-inch grid as ground; white tissue pattern pieces with printed labels and grainlines as content; orange (#E9670D) only for pointer arrows, notches, the tape flag, and the action; black line diagrams; condensed caps labels, hyperlegible body.
STORY: A donor sees a real woman at a real machine, reads what each gift makes, sees the four steps by which the center pays its own way, and sponsors a student for $30 a month.
FIRST VIEWPORT: Mat full-bleed; Piece 1 left ~60% with label, tagline, monumental "$30 a month", orange arrow to the "Sponsor a student" stamp; photo plate overlapping the piece's right edge onto the mat; nav as the views list.
FORM: The Pattern Sheet, #5 of 7 on the re-rolled list; seed 7b52788d (re-roll 1).
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->
    <a href="#content" class="skip-link">Skip to content</a>

    <div class="mat-ruler" aria-hidden="true">
      {rulerInches.map((n) => <span class="mat-ruler__mark">{n}</span>)}
    </div>

    <Nav />

    <main id="content" class={mainClass}>
      <slot />
    </main>

    <Footer />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        document.documentElement.setAttribute('data-settled', 'true');
      });
    </script>
  </body>
</html>
