---
// Instruction-sheet line diagrams: authored, geometric, one stroke weight.
export interface Props {
  variant: 'machine' | 'meal' | 'goods' | 'building';
  class?: string;
}

const { variant, class: className } = Astro.props;

const titles: Record<Props['variant'], string> = {
  machine: 'A sewing machine',
  meal: 'A plate and cup',
  goods: 'Folded goods with a hang tag',
  building: 'A one-story building',
};
---

<svg
  viewBox="0 0 96 96"
  class:list={['diagram', className]}
  role="img"
  aria-label={titles[variant]}
  fill="none"
  stroke="var(--ink)"
  stroke-width="2"
  stroke-linecap="square"
  stroke-linejoin="miter"
>
  {
    variant === 'machine' && (
      <g>
        <rect x="14" y="64" width="68" height="10" />
        <path d="M66 20 C 40 20, 26 40, 26 64" />
        <line x1="66" y1="20" x2="66" y2="64" />
        <line x1="66" y1="10" x2="66" y2="20" />
        <circle cx="30" cy="48" r="6" />
      </g>
    )
  }
  {
    variant === 'meal' && (
      <g>
        <circle cx="40" cy="62" r="26" />
        <circle cx="40" cy="62" r="15" />
        <path d="M72 18 h14 v16 a7 7 0 0 1 -14 0 z" />
        <path d="M86 22 a6 6 0 0 1 0 12" />
      </g>
    )
  }
  {
    variant === 'goods' && (
      <g>
        <rect x="14" y="58" width="54" height="12" />
        <rect x="14" y="45" width="54" height="12" />
        <rect x="14" y="32" width="54" height="12" />
        <path d="M68 38 h12 v16 l-6 6 l-6 -6 z" />
        <circle cx="74" cy="45" r="1.6" fill="var(--ink)" />
      </g>
    )
  }
  {
    variant === 'building' && (
      <g>
        <rect x="16" y="38" width="64" height="40" />
        <path d="M12 38 L48 18 L84 38" />
        <rect x="42" y="56" width="12" height="22" />
        <rect x="24" y="48" width="10" height="10" />
        <rect x="62" y="48" width="10" height="10" />
      </g>
    )
  }
</svg>

<style>
  .diagram {
    width: 96px;
    height: 96px;
    display: block;
  }
</style>
