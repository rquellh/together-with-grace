---
// The orange action arrow: points from a piece's content toward the action.
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['pointer-arrow', className]} aria-hidden="true">
  <svg viewBox="0 0 96 28" class="pointer-arrow__svg" focusable="false">
    <line x1="2" y1="14" x2="76" y2="14" stroke="var(--orange)" stroke-width="3" />
    <path d="M76 3 L94 14 L76 25 Z" fill="var(--orange)" />
  </svg>
</span>

<style>
  .pointer-arrow {
    display: inline-flex;
    align-items: center;
  }

  .pointer-arrow__svg {
    width: 72px;
    height: 21px;
  }

  @media (max-width: 639px) {
    .pointer-arrow {
      transform: rotate(90deg);
      margin-block: var(--quarter);
    }
  }
</style>
