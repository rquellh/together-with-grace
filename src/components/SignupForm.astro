---
import {
  GIVEBUTTER_SIGNUP_WIDGET_ID,
  GIVEBUTTER_SIGNUP_URL,
  GIVEBUTTER_WIDGETS_SRC,
} from '../config/givebutter';

// Unlike the giving form, a signup form cannot be configured from attributes alone: the
// widgets script only builds its iframe from the config of a widget created in the
// Givebutter dashboard, so it needs that widget's id (verified against the script's
// required-props check, which wants `account` + `id` for signup forms).
const hasWidget = GIVEBUTTER_SIGNUP_WIDGET_ID.length > 0;
---

{
  hasWidget ? (
    <div class="signup-embed">
      <script is:inline async src={GIVEBUTTER_WIDGETS_SRC}></script>
      <div class="signup-form">
        <givebutter-widget id={GIVEBUTTER_SIGNUP_WIDGET_ID} />
        <noscript>
          <a class="btn ghost" href={GIVEBUTTER_SIGNUP_URL}>
            Follow us on Givebutter
          </a>
        </noscript>
      </div>
    </div>
  ) : (
    <div class="signup-embed">
      <a class="btn ghost" href={GIVEBUTTER_SIGNUP_URL}>
        Follow us on Givebutter
      </a>
      <p class="caps signup-note">Opens our page on Givebutter</p>
    </div>
  )
}

<style is:global>
  /* is:global: Astro's default scoped-style attribute would otherwise land on
     <givebutter-widget>, a third-party custom element we'd rather hand
     to Givebutter's widget script exactly as documented. */
  .signup-embed {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .signup-form {
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }

  .signup-note {
    /* Legible Orange Rule: on-ink grounds need the ink-safe ember shade, not the
       muslin-tuned --orange-text (this component is embedded on-ink on Contact) */
    color: var(--orange-text);
  }

  .on-ink .signup-note {
    color: var(--orange-bright);
  }
</style>
