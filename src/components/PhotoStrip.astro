---
/**
 * PhotoStrip — a row of prints pinned along the cloth, drifting sideways.
 * Embla Carousel (MIT) + its AutoScroll plugin; loops, drags, pauses on hover
 * or focus, and stays still under prefers-reduced-motion.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  photos: Photo[];
  label?: string;
}

const { photos, label = 'Photographs from the sewing center' } = Astro.props;
const tilts = [-1.6, 1.1, -0.8, 1.7, -1.2, 0.9];
---

<section class="strip" aria-label={label}>
  <div class="strip-viewport" data-strip tabindex="0">
    <div class="strip-track">
      {
        photos.map((p, i) => (
          <figure class="strip-print" style={`--tilt:${tilts[i % tilts.length]}deg`}>
            <Image
              src={p.src}
              alt={p.alt}
              height={640}
              densities={[1, 1.5]}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';
  import AutoScroll from 'embla-carousel-auto-scroll';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const viewport of document.querySelectorAll<HTMLElement>('[data-strip]')) {
    const embla = EmblaCarousel(
      viewport,
      { loop: true, dragFree: true, align: 'start', containScroll: false, skipSnaps: true },
      reduced
        ? []
        : [
            AutoScroll({
              speed: 0.9,
              startDelay: 600,
              stopOnInteraction: false,
              stopOnMouseEnter: true,
              stopOnFocusIn: true,
            }),
          ],
    );

    // keyboard: the viewport is focusable; arrows nudge the strip
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') embla.scrollNext();
      if (e.key === 'ArrowLeft') embla.scrollPrev();
    });
  }
</script>

<style>
  .strip {
    width: 100%;
    padding-block: 0.5rem 1.4rem;
  }

  .strip-viewport {
    overflow: hidden;
    cursor: grab;
    /* room for the tilted prints' shadows without clipping */
    padding-block: 0.9rem;
  }

  .strip-viewport:active {
    cursor: grabbing;
  }

  .strip-viewport:focus-visible {
    outline-offset: -3px;
  }

  .strip-track {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.6rem);
    touch-action: pan-y pinch-zoom;
    backface-visibility: hidden;
  }

  .strip-print {
    flex: 0 0 auto;
    margin: 0;
    background: var(--selvage-white);
    padding: 0.4rem 0.4rem 0.5rem;
    box-shadow: var(--shadow-soft);
    transform: rotate(var(--tilt, 0deg));
  }

  .strip-print img {
    display: block;
    height: clamp(11rem, 24vw, 17rem);
    width: auto;
    -webkit-user-drag: none;
    user-select: none;
  }
</style>
