---
// The primary action: a rubber-stamp impression. Renders as a link when
// `href` is given, or as a real <button> (for forms) when it is not.
import { withBase } from '../lib/url';

export interface Props {
  href?: string;
  label: string;
  variant?: 'solid' | 'outline';
  surface?: 'tissue' | 'mat';
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
  ariaCurrent?: 'page';
}

const {
  href,
  label,
  variant = 'solid',
  surface = 'tissue',
  type = 'button',
  class: className,
  id,
  ariaCurrent,
} = Astro.props;

const classes = ['stamp-button', `stamp-button--${variant}`, `stamp-button--on-${surface}`, className];
const isExternal = typeof href === 'string' && /^https?:\/\//.test(href);
const resolvedHref = typeof href === 'string' && href.startsWith('/') ? withBase(href) : href;
---

{
  href ? (
    <a
      href={resolvedHref}
      id={id}
      class:list={classes}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      aria-current={ariaCurrent}
    >
      {label}
    </a>
  ) : (
    <button type={type} id={id} class:list={classes}>
      {label}
    </button>
  )
}

<style>
  .stamp-button {
    display: inline-block;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 12px 24px;
    border: 1.5px solid var(--ink);
    text-decoration: none;
    cursor: pointer;
    line-height: 1.2;
  }

  .stamp-button--solid {
    background: var(--orange);
    color: var(--ink);
  }

  .stamp-button--solid:hover {
    background: var(--ink);
    color: var(--orange);
  }

  .stamp-button--outline {
    background: transparent;
  }

  .stamp-button--outline.stamp-button--on-tissue {
    border-color: var(--ink);
    color: var(--ink);
  }

  .stamp-button--outline.stamp-button--on-mat {
    border-color: var(--mat-ink);
    color: var(--mat-ink);
  }

  .stamp-button--outline:hover {
    border-color: var(--orange);
    color: var(--orange);
  }

  .stamp-button:active {
    transform: translateY(1px);
  }

  .stamp-button:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }
</style>
