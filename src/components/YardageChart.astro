---
// The envelope-back chart: what each gift covers, as the ministry
// publishes the figures. A real table; the whole row is a link.
import Piece from './Piece.astro';
import TapeFlag from './TapeFlag.astro';
import StampButton from './StampButton.astro';

export interface Props {
  style?: string;
}

const { style } = Astro.props;

const rows = [
  {
    gift: '$30',
    covers: "One student's place at the center: her training, daily meal, and materials.",
    per: 'a month',
    href: '/give?amount=30',
    flag: 'SPONSOR',
  },
  {
    gift: '$100',
    covers:
      'Covers the cost of a nutritious lunch for 25 - 30 ladies throughout an entire month while they spend time at the sewing center.',
    per: 'one month',
    href: '/give?amount=100',
  },
  {
    gift: '$100',
    covers:
      'Our monthly budget allocates funds for the ongoing maintenance of sewing machines and commercial irons, including any necessary repairs. This also facilitates the potential replacement of machines when needed.',
    per: 'one month',
    href: '/give?amount=100',
  },
  {
    gift: '$175',
    covers:
      'Monthly utility expenses, including electricity, water, and internet, are vital components supported by your generous contribution.',
    per: 'one month',
    href: '/give?amount=175',
  },
  {
    gift: '$500',
    covers:
      'Monthly rent for secure and well-appointed facilities, encompassing two sewing rooms, a kitchen, an office, two and a half baths, and guard room ensuring a safe and comfortable environment.',
    per: 'one month',
    href: '/give?amount=500',
  },
];
---

<Piece as="div" shape="rect" label="PIECE 2 · YARDAGE" cut="CUT 1" class="yardage" style={style}>
  <div class="yardage__scroll">
    <table class="yardage__table">
      <caption class="visually-hidden">What each gift covers</caption>
      <thead>
        <tr>
          <th scope="col">Gift</th>
          <th scope="col">Covers</th>
          <th scope="col">Per</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="yardage__row">
              <td class="yardage__gift">
                <a href={row.href} class="yardage__row-link">
                  <span class="amount tabular">{row.gift}</span>
                  {row.flag && <TapeFlag label={row.flag} class="yardage__flag" />}
                </a>
              </td>
              <td>{row.covers}</td>
              <td class="yardage__per tabular">{row.per}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="yardage__note">
    With the exception of credit card transaction fees, every dollar of your donation directly contributes to
    empowering these women to launch a successful business.
  </p>
  <p class="yardage__note">
    Unless otherwise specified, your donation will be used for one or many of the following recurring costs.
  </p>
  <StampButton href="/give" label="Give" />
</Piece>

<style>
  .yardage__scroll {
    overflow-x: auto;
    margin-bottom: var(--half);
  }

  .yardage__table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    margin-bottom: 0;
  }

  .yardage__table th,
  .yardage__table td {
    text-align: left;
    padding: var(--quarter) var(--quarter) var(--quarter) 0;
    border-bottom: 1px solid var(--ink);
    vertical-align: top;
  }

  .yardage__table th {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--size-label-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .yardage__row {
    position: relative;
  }

  .yardage__gift {
    min-width: 11rem;
  }

  .yardage__per {
    white-space: nowrap;
  }

  .yardage__row-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
  }

  :global(.yardage__flag) {
    display: block;
    margin-top: 8px;
  }

  .yardage__row-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .yardage__row-link:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  .amount {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 2.25rem;
    color: var(--ink);
  }

  .yardage__row:hover .amount,
  .yardage__row:focus-within .amount {
    color: var(--orange);
  }

  .yardage__note {
    color: var(--tissue-ink-2);
    font-size: var(--size-body);
    max-width: var(--measure);
  }
</style>
