---
/**
 * LetterSignup — a button that opens the Givebutter email-signup widget in a
 * native <dialog>, so the News pages can offer "tell me when a new letter is
 * posted" without a whole band the way Contact used to carry it.
 */
import {
  GIVEBUTTER_SIGNUP_WIDGET_ID,
  GIVEBUTTER_SIGNUP_URL,
  GIVEBUTTER_WIDGETS_SRC,
} from '../config/givebutter';

interface Props {
  /** button class variant */
  tone?: 'ink' | 'sun' | 'ghost';
  label?: string;
}

const { tone = 'ghost', label = 'Be notified of new letters' } = Astro.props;

// Same reasoning as SignupForm: the widget needs its own id from the dashboard,
// not just the account id, so without one we fall back to a plain link.
const hasWidget = GIVEBUTTER_SIGNUP_WIDGET_ID.length > 0;
---

{
  !hasWidget ? (
    <a class={`btn ${tone}`} href={GIVEBUTTER_SIGNUP_URL}>
      {label}
    </a>
  ) : (
    <Fragment>
      <script is:inline async src={GIVEBUTTER_WIDGETS_SRC}></script>
      <button class={`btn ${tone} letter-signup-open`} type="button">
        {label}
      </button>
      <dialog
        class="letter-signup"
        data-widget-id={GIVEBUTTER_SIGNUP_WIDGET_ID}
        aria-labelledby="letter-signup-title"
      >
        <div class="letter-signup-sheet">
          <button class="letter-signup-close" type="button" aria-label="Close">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
              <path d="M2 2 L14 14 M14 2 L2 14" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" />
            </svg>
          </button>
          <p id="letter-signup-title" class="caps letter-signup-label">
            Be notified of new letters
          </p>
          <div class="letter-signup-slot" />
          <noscript>
            <a class="btn ghost" href={GIVEBUTTER_SIGNUP_URL}>
              Sign up on Givebutter
            </a>
          </noscript>
        </div>
      </dialog>
    </Fragment>
  )
}

<script>
  // Givebutter's signup card keeps an 8rem image slot at the top even when no
  // image is set in the dashboard, which reads as dead space in a modal. Both
  // shadow roots are open, so once the card has rendered, a style that hides
  // the slot only while its background-image is empty can be dropped in. If an
  // image is ever added in the dashboard, the slot shows again untouched.
  function trimEmptyImageSlot(widget: HTMLElement) {
    const started = Date.now();
    const tick = () => {
      const inner = widget.shadowRoot?.querySelector('givebutter-signup-form')?.shadowRoot;
      if (inner) {
        const style = document.createElement('style');
        style.textContent = 'div[style*="background-image:url()"] { display: none; }';
        inner.append(style);
        return;
      }
      if (Date.now() - started < 15000) setTimeout(tick, 150);
    };
    tick();
  }

  // Handle every LetterSignup instance on the page: each opener button is
  // immediately followed by its own dialog.
  document.querySelectorAll<HTMLButtonElement>('.letter-signup-open').forEach((button) => {
    const dialog = button.nextElementSibling;
    if (!(dialog instanceof HTMLDialogElement) || !dialog.classList.contains('letter-signup')) {
      return;
    }

    const closeButton = dialog.querySelector<HTMLButtonElement>('.letter-signup-close');
    const slot = dialog.querySelector<HTMLDivElement>('.letter-signup-slot');
    let widgetInserted = false;

    button.addEventListener('click', () => {
      // The widget's iframe would size itself against display:none if it were
      // created before the dialog is shown, so it's inserted lazily on first open.
      if (!widgetInserted && slot) {
        const widget = document.createElement('givebutter-widget');
        widget.setAttribute('id', dialog.dataset.widgetId ?? '');
        slot.append(widget);
        widgetInserted = true;
        trimEmptyImageSlot(widget);
      }
      dialog.showModal();
    });

    closeButton?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      // A click that lands on the dialog element itself (not the sheet inside
      // it) is a click on the backdrop.
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => button.focus());
  });
</script>

<style is:global>
  /* .btn is written for an <a>; a <button> also needs the browser's bevel and
     line-height reset so it sits identically beside the link buttons */
  button.letter-signup-open {
    appearance: none;
    border: 0;
    line-height: inherit;
    cursor: pointer;
  }

  /* is:global: like GiveForm, <givebutter-widget> is a third-party custom
     element we hand to the widget script exactly as documented, and
     dialog::backdrop is a pseudo-element Astro's scoped attribute selectors
     can't reach. */
  dialog.letter-signup {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 30rem);
    width: 100%;
    /* the close tag overhangs the sheet's corner; the UA style would clip it */
    overflow: visible;
  }

  dialog.letter-signup::backdrop {
    background: rgb(0 27 39 / 0.72);
  }

  .letter-signup-sheet {
    position: relative;
    background: var(--muslin);
    padding: clamp(1.25rem, 4vw, 2rem);
    box-shadow: var(--shadow-lift);
  }

  .letter-signup-sheet::after {
    /* the stitched inset every label/sheet on the site carries */
    content: '';
    position: absolute;
    inset: 8px;
    border: 1.5px dashed var(--orange-deep);
    opacity: 0.5;
    pointer-events: none;
  }

  .letter-signup-label {
    margin-bottom: 1rem;
    color: var(--orange-text);
  }


  /* a small ink tag pinned over the sheet's corner, stitched like every .btn */
  .letter-signup-close {
    position: absolute;
    top: -0.7rem;
    right: -0.7rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 0;
    appearance: none;
    background: var(--ink);
    color: var(--muslin);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease-out;
  }

  .letter-signup-close::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1.5px dashed currentColor;
    opacity: 0.65;
    pointer-events: none;
  }

  .letter-signup-close:hover {
    transform: translateY(-2px) rotate(-3deg);
    box-shadow: var(--shadow-lift);
  }

  /* no box of its own: the widget renders its own ~420px-wide white card */
  .letter-signup-slot {
    margin-top: 0.25rem;
    min-height: 4rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog.letter-signup[open] {
      animation: letter-signup-fade 0.2s ease-out;
    }
  }

  @keyframes letter-signup-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
