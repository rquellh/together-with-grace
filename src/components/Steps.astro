---
// The instruction sheet: how the center pays its own way, in four steps —
// a 2x2 sequence of unequal cells (7/5 then 5/7) on desktop, reading
// left-to-right, top-to-bottom, like a real cutting layout with fold
// lines between the panels.
import Piece from './Piece.astro';
import Diagram from './Diagram.astro';

export interface Props {
  style?: string;
}

const { style } = Astro.props;

const steps = [
  {
    n: '1',
    variant: 'machine' as const,
    size: 'lg' as const,
    h3: 'Vicki flies to Libreville.',
    body: 'Vicki Quellhorst has been to the center fifteen times since June 2013. She teaches every level of sewing, leads the business training, and prepares the women who will train the next class. Tim has made four trips to repair machines and equipment.',
  },
  {
    n: '2',
    variant: 'meal' as const,
    size: 'sm' as const,
    h3: 'Women learn at the machines — and eat.',
    body: 'Students learn sewing, machine care, and how to price and sell what they make. The center serves a daily meal and begins each day with praise and prayer. In July 2024, 27 students were enrolled.',
  },
  {
    n: '3',
    variant: 'goods' as const,
    size: 'sm' as const,
    h3: 'What they make, sells.',
    body: 'Bed runners and shams for a 130-room hotel. Lamp bases. Dolls sold through Believe, Art from the Heart in Sidney, Ohio. Pagne fabric at the Libreville Airport Gift Shop. By December 2023 the center had sold $4,800 of its work.',
  },
  {
    n: '4',
    variant: 'building' as const,
    size: 'lg' as const,
    h3: 'The center pays its own way.',
    body: "Sales and support covered 60.7% of the center's operating costs in July 2024. The goal is a sewing facility that runs without donor support — and women who go on to open their own.",
  },
];

// Steps 1-3 each carry a trailing "FOLD" rule; step 4 is the last cell in
// the layout in both the desktop 2x2 and the mobile single column, so it
// never gets one.
const foldAfter = (i: number) => i < steps.length - 1;
---

<Piece as="div" shape="rect" label="INSTRUCTION SHEET" cut="STEPS 1–4" class="steps-piece" style={style}>
  <h2>How the center pays its own way</h2>
  <ol class="steps-list">
    {
      steps.map((step, i) => (
        <li class={`steps-list__item steps-list__item--${i + 1}`}>
          <div class="steps-list__top">
            <span class="steps-list__number tabular" aria-hidden="true">
              {step.n}
            </span>
            <Diagram variant={step.variant} class={`steps-list__diagram steps-list__diagram--${step.size}`} />
          </div>
          <h3>{step.h3}</h3>
          <p>{step.body}</p>
          {foldAfter(i) && (
            <span class="steps-list__fold label" aria-hidden="true">
              FOLD
            </span>
          )}
        </li>
      ))
    }
  </ol>
</Piece>

<style>
  .steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .steps-list__item {
    position: relative;
  }

  /* Mobile: single column, same 1-2-3-4 order, a fold rule under each of
     the first three steps. */
  .steps-list__item:not(.steps-list__item--4) {
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--half);
    margin-bottom: var(--half);
  }

  @media (min-width: 900px) {
    /* A 2x2 sequence with unequal cells: row 1 splits 7/5, row 2 splits
       5/7 — an instruction sheet, not four identical columns. */
    .steps-list {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--half);
    }

    .steps-list__item:not(.steps-list__item--4) {
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 0;
    }

    .steps-list__item--1 {
      grid-column: 1 / 8;
      grid-row: 1;
      border-right: 1px solid var(--ink);
      border-bottom: 1px solid var(--ink);
      padding-right: var(--half);
      padding-bottom: var(--half);
    }
    .steps-list__item--2 {
      grid-column: 8 / 13;
      grid-row: 1;
      border-bottom: 1px solid var(--ink);
      padding-left: var(--half);
      padding-bottom: var(--half);
    }
    .steps-list__item--3 {
      grid-column: 1 / 6;
      grid-row: 2;
      border-right: 1px solid var(--ink);
      padding-top: var(--half);
      padding-right: var(--half);
    }
    .steps-list__item--4 {
      grid-column: 6 / 13;
      grid-row: 2;
      padding-top: var(--half);
      padding-left: var(--half);
    }
  }

  /* The fold label sits at the end of whichever rule the item carries —
     bottom-right reads correctly whether that rule is the item's own
     right edge (a vertical fold) or its bottom edge (a horizontal fold
     shared with its row neighbor). */
  .steps-list__fold {
    position: absolute;
    right: 0;
    bottom: 4px;
    color: var(--ink);
  }

  .steps-list__top {
    display: flex;
    align-items: center;
    gap: var(--half);
    /* Reserves room for the larger (144px) diagram so numeral position
       and the h3 below it still align between a wide and a narrow cell
       in the same row. */
    min-height: 96px;
    margin-bottom: var(--quarter);
  }

  @media (min-width: 900px) {
    .steps-list__top {
      min-height: 144px;
    }
  }

  .steps-list__number {
    display: block;
    flex: none;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 3rem;
    color: var(--ink);
    line-height: 1;
  }

  :global(.steps-list__diagram) {
    width: 96px;
    height: 96px;
    flex: none;
  }

  @media (min-width: 900px) {
    :global(.steps-list__diagram--lg) {
      width: 144px;
      height: 144px;
    }
    :global(.steps-list__diagram--sm) {
      width: 112px;
      height: 112px;
    }
  }

  .steps-list__item h3 {
    margin-top: 0;
  }

  .steps-list__item p {
    max-width: none;
  }
</style>
